<?xml version="1.0" encoding="UTF-8"?>
<!--
  The control for the Phase 2 spike, not a shipping configuration.

  If the sandboxed bundle cannot reach 192.168.100.1, that alone doesn't say
  why: it could be the sandbox, Local Network TCC, or something in the Go net
  stack that behaves differently inside a bundle. Building the same binary with
  the same signature and only this file changed isolates the sandbox as a
  variable — one bit, one rebuild.

  `make app SANDBOX=0` uses this. Never ship it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
